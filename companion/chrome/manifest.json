{
  "manifest_version": 3,
  "name": "Morgan YouTube Cookie Companion",
  "description": "Explicitly transfer a YouTube Incognito session to Morgan's local Keychain-backed native host.",
  "version": "1.0.0",
  "minimum_chrome_version": "119",
  "incognito": "split",
  "permissions": ["cookies", "nativeMessaging"],
  "host_permissions": ["https://*.youtube.com/*"],
  "action": {"default_popup": "popup.html", "default_title": "Morgan YouTube Session"},
  "key": ""
}
